# Maintainer: mlm-games
pkgname=tiny-settlements
pkgver=0.1.0
pkgrel=1
pkgdesc="Tiny Settlements - card-based ecosystem gardener"
arch=('x86_64')
url="https://github.com/mlm-games/tiny-settlements"
license=('GPL3')
depends=('alsa-lib' 'libx11' 'libxcb' 'wayland')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mlm-games/tiny-settlements/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cargo build --release
}

package() {
    install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
}
